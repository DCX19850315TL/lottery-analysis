# ==============================================
# 以下模式【故意不启用】—— 不要取消注释
# ==============================================
# 原因：data/ 下有 11181 个已跟踪文件、75 个 .pkl 模型，是「数据冻结提交」
# 工作流的载体。启用后新建的模型/数据文件会被静默忽略，提交需 git add -f。
# 若将来要收紧，请单独评估后再逐条启用。
#
#   *.log            # 日志（与 data/*.log 工作习惯冲突）
#   *.db *.sqlite *.sql *.dump
#   *.csv *.tsv *.jsonl *.parquet *.pkl
#   data/
#   dataset/ logs/ results/ output/ reports/
#   catboost_info/

# ==============================================
# 本地工具产物 (勿提交)
# ==============================================
# .codex/config.toml 含明文 TUSHARE_TOKEN, 必须留在本地
.codex/
.ua/
# 空文件, 误操作产物
cd

# 本地行情缓存 (klines SQLite 缓存, 由 realtime_monitor --sync-klines 生成)
veighna/data/veighna.db*
data/realtime/
catboost_info/

# 晚间链运行时产物（阶段状态/日志/单实例锁，由 scripts/_evening_chain.py 生成）
data/_evening_chain.log
data/_evening_chain.lock
data/_evening_chain_state.json
# klines JSON 单写者锁（scripts/_update_klines_baostock.py）
data/klines_ohlcv.json.lock
data/klines_daily_progress_*.json

